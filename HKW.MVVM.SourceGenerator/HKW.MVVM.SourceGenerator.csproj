<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>0.2.2</Version>
    <Company>HKW</Company>
    <Authors>HKW</Authors>
    <PackageDescription>An source generator MVVM library, based on CommunityToolkit.Mvvm, using SourceGenerator and Fody for mixed source code generation.</PackageDescription>
    <PackageTags>MVVM;Observable;Fody;SourceGenerator;CommunityToolkit;</PackageTags>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>HKW.MVVM.SourceGenerator</PackageId>
    <WeaverDirPath>..\HKW.MVVM.SourceGenerator.Fody\bin\$(Configuration)\</WeaverDirPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeGeneratorAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <PathMap Condition="'$(SolutionDir)' != ''">$(SolutionDir)=/_/</PathMap>
    <PathMap Condition="'$(SolutionDir)' == ''"
      >$(MSBuildProjectDirectory)=/_/$(AssemblyName)/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="11.0.0"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference
      Include="..\HKW.MVVM.SourceGenerator.Fody\HKW.MVVM.SourceGenerator.Fody.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\HKW.MVVM.SourceGenerator.Generators\HKW.MVVM.SourceGenerator.Generators.csproj"
      ReferenceOutputAssembly="false"
    />
    <PackageReference Include="FodyPackaging" Version="6.9.3" PrivateAssets="all" />
    <!-- 仅用于将 HKW.SourceGeneratorUtils.dll 打包进 analyzers/dotnet/cs, 不作为运行时程序集引用 -->
    <PackageReference
      Include="HKW.SourceGeneratorUtils"
      Version="0.2.3"
      PrivateAssets="all"
      ExcludeAssets="all"
      GeneratePathProperty="true"
    />
  </ItemGroup>

  <Target Name="IncludeGeneratorAnalyzers">
    <PropertyGroup>
      <GeneratorAssemblyPath>..\HKW.MVVM.SourceGenerator.Generators\bin\$(Configuration)\netstandard2.0\HKW.MVVM.SourceGenerator.Generators.dll</GeneratorAssemblyPath>
    </PropertyGroup>

    <Error
      Text="Generator assembly not found at $(GeneratorAssemblyPath). Ensure HKW.MVVM.SourceGenerator.Generators is built before packing."
      Condition="!Exists('$(GeneratorAssemblyPath)')"
    />

    <ItemGroup>
      <!-- 必须将源生成器及辅助库 dll 导入 NuGet 分析器目录, 否则 NuGet 无法使用源生成 -->
      <TfmSpecificPackageFile
        Include="$(GeneratorAssemblyPath)"
        PackagePath="analyzers/dotnet/cs/HKW.MVVM.SourceGenerator.Generators.dll"
      />
      <TfmSpecificPackageFile
        Include="$(PkgHKW_SourceGeneratorUtils)\lib\netstandard2.0\HKW.SourceGeneratorUtils.dll"
        PackagePath="analyzers/dotnet/cs/HKW.SourceGeneratorUtils.dll"
      />
    </ItemGroup>
  </Target>
</Project>
